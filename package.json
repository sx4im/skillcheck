{
  "name": "@sx4im/skillcheck",
  "version": "0.11.0",
  "description": "Controlled A/B testing for AI agent skills, .cursorrules, CLAUDE.md, and system prompts: blind grading, bootstrap confidence intervals, and HELPS/PLACEBO/HARMS effect size measurement.",
  "type": "module",
  "license": "MIT",
  "author": "sx4im",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sx4im/skillcheck.git"
  },
  "bugs": {
    "url": "https://github.com/sx4im/skillcheck/issues"
  },
  "homepage": "https://dashboard-skillcheck.vercel.app/",
  "keywords": [
    "cli",
    "llm",
    "ai-agent",
    "ai-agents",
    "agent-skills",
    "skill-testing",
    "cursorrules",
    "cursor-rules",
    "claude-code",
    "claude-code-skills",
    "copilot-instructions",
    "system-prompts",
    "prompt-engineering",
    "prompt-testing",
    "prompt-evaluation",
    "prompt-optimization",
    "llm-eval",
    "llm-evaluation",
    "llm-benchmark",
    "evals",
    "evaluation",
    "ab-testing",
    "blind-grading",
    "agentic-ai",
    "developer-tools",
    "benchmark",
    "testing",
    "typescript",
    "nodejs"
  ],
  "bin": {
    "skillcheck": "dist/bin/skillcheck.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "METHODOLOGY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "m0": "tsx packages/cli/bin/skillcheck.ts m0",
    "site:build": "next build packages/site",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run test:coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "openai": "^4.77.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
