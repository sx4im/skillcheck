# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Credential precedence (highest first):
#   1. NVIDIA_API_KEY      — direct mode: call NVIDIA NIM yourself, bypassing the proxy
#   2. SKILLCHECK_TOKEN    — hosted mode: a Skillcheck Cloud key (chk_live_…)
#   3. saved config        — written by `skillcheck setup`

# Option A: hosted mode. Get a free key from the Skillcheck dashboard.
# SKILLCHECK_TOKEN=chk_live_...
# Self-hosted proxy? Point the CLI at your own deployment (defaults to the hosted cloud):
# SKILLCHECK_API_URL=https://your-deployment.example.com/api

# Option B: direct mode with your own NVIDIA NIM key (maintainers/CI).
NVIDIA_API_KEY=

# OpenAI-compatible NVIDIA NIM endpoint (direct mode only).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional request timeout in milliseconds. Defaults to 120000.
# NVIDIA_TIMEOUT_MS=120000

# Optional minimum delay between process-wide model requests. Defaults to 750.
# Raise it if you hit 429s; lower it for faster runs on a higher-rate key.
# NVIDIA_REQUEST_DELAY_MS=750

# Optional retryable request attempt budget. Defaults to 8.
# NVIDIA_MAX_ATTEMPTS=8

# Optional cap for fallback retry backoff in milliseconds. Defaults to 60000.
# NVIDIA_MAX_RETRY_DELAY_MS=60000

# Optional model overrides (direct mode). Defaults to openai/gpt-oss-120b — the
# strongest model in NIM's fast lane with dependable JSON mode (see README "Model
# choice"). nvidia/nemotron-3-nano-omni-30b-a3b-reasoning is the low-latency
# alternative. Override per role or all at once:
# NVIDIA_GENERATOR_MODEL=openai/gpt-oss-120b
# NVIDIA_GRADER_MODEL=openai/gpt-oss-120b
# NVIDIA_RUNNER_MODEL=openai/gpt-oss-120b
# SKILLCHECK_MODEL=openai/gpt-oss-120b

# Set to 1 to disable the once-a-day npm update check.
# SKILLCHECK_NO_UPDATE_CHECK=1

# Set to 1 for verbose retry/debug logging.
# SKILLCHECK_DEBUG=1
# SKILLCHECK_DEBUG_RETRIES=1
