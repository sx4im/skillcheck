# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Option A: direct local NVIDIA NIM calls.
NVIDIA_API_KEY=

# Option B: hosted hidden-key mode. Point the CLI at your OpenAI-compatible proxy.
# The proxy keeps NVIDIA_API_KEY on the server, not inside the npm package.
# SKILLCHECK_API_URL=https://your-proxy.example.com/v1
# SKILLCHECK_API_KEY=

# OpenAI-compatible NVIDIA NIM endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional request timeout in milliseconds. Defaults to 120000.
# NVIDIA_TIMEOUT_MS=120000

# Optional minimum delay between process-wide NVIDIA requests. Defaults to 5000.
# 1500ms matches 40 RPM exactly; use a margin for hosted NIM launch runs.
# NVIDIA_REQUEST_DELAY_MS=5000

# Optional retryable request attempt budget. Defaults to 8.
# NVIDIA_MAX_ATTEMPTS=8

# Optional cap for fallback retry backoff in milliseconds. Defaults to 60000.
# NVIDIA_MAX_RETRY_DELAY_MS=60000

# Optional model overrides. Defaults to qwen/qwen3-next-80b-a3b-instruct.
# NVIDIA_GENERATOR_MODEL=qwen/qwen3-next-80b-a3b-instruct
# NVIDIA_GRADER_MODEL=qwen/qwen3-next-80b-a3b-instruct
# NVIDIA_RUNNER_MODEL=qwen/qwen3-next-80b-a3b-instruct
# SKILLCHECK_MODEL=qwen/qwen3-next-80b-a3b-instruct
