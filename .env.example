# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Credential precedence (highest first):
#   1. NVIDIA_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY / GROQ_API_KEY / MISTRAL_API_KEY / OPENROUTER_API_KEY
#   2. SKILLCHECK_TOKEN    — hosted mode: a Skillcheck Cloud key (chk_live_…)
#   3. saved config        — written by `skillcheck setup`

# Option A: hosted mode. Get a free key from the Skillcheck dashboard.
# SKILLCHECK_TOKEN=chk_live_...
# Self-hosted proxy? Point the CLI at your own deployment (defaults to the hosted cloud):
# SKILLCHECK_API_URL=https://your-deployment.example.com/api

# Option B: Bring Your Own Key (direct mode)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA_API_KEY=nvapi-...

# Optional provider base URL overrides (direct mode):
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional request timeout in milliseconds. Defaults to 120000.
# SKILLCHECK_TIMEOUT_MS=120000

# Optional minimum delay between process-wide model requests. Defaults to 750.
# SKILLCHECK_REQUEST_DELAY_MS=750

# Optional model overrides per role or all at once:
# OPENAI_GENERATOR_MODEL=gpt-4o
# OPENAI_RUNNER_MODEL=gpt-4o
# OPENAI_GRADER_MODEL=gpt-4o
# ANTHROPIC_RUNNER_MODEL=claude-3-5-sonnet-20241022
# GEMINI_RUNNER_MODEL=gemini-1.5-pro
# NVIDIA_GENERATOR_MODEL=openai/gpt-oss-120b
# SKILLCHECK_MODEL=openai/gpt-oss-120b

# Set to 1 to disable the once-a-day npm update check.
# SKILLCHECK_NO_UPDATE_CHECK=1

# Set to 1 for verbose retry/debug logging.
# SKILLCHECK_DEBUG=1
# SKILLCHECK_DEBUG_RETRIES=1
