# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Required for all live NVIDIA NIM calls.
NVIDIA_API_KEY=

# OpenAI-compatible NVIDIA NIM endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional request timeout in milliseconds. Defaults to 120000.
# NVIDIA_TIMEOUT_MS=120000

# Optional minimum delay between NVIDIA requests from one client. Defaults to 5000.
# NVIDIA_REQUEST_DELAY_MS=5000

# Optional retryable request attempt budget. Defaults to 8.
# NVIDIA_MAX_ATTEMPTS=8

# Verified on build.nvidia.com on 2026-06-03.
NVIDIA_GENERATOR_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_GRADER_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_RUNNER_MODEL=mistralai/mistral-small-4-119b-2603
